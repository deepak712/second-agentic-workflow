# Copy to .env and fill in. NEVER commit .env.
# .env is the ONLY place secrets live.

# --- LLM / API providers ---
ANTHROPIC_API_KEY=

# --- Email delivery ---
# Provider is chosen with `--provider` on tools/send_email.py (default: smtp).

# smtp: Gmail needs an App Password, NOT your account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# resend: HTTPS alternative for environments that block outbound port 587
# (e.g. a cloud sandbox). Get a key at https://resend.com — the free tier can
# send from onboarding@resend.dev without owning a domain.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Where the daily report is sent (applies to both providers).
REPORT_TO_EMAIL=
